{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Data Factory name",
            "defaultValue": "atliq-adf-meet"
        },
        "ls_azure_sql_password": {
            "type": "secureString",
            "metadata": "Secure string for 'password' of 'ls_azure_sql'"
        },
        "ls_adls_accountKey": {
            "type": "secureString",
            "metadata": "Secure string for 'accountKey' of 'ls_adls'"
        },
        "ls_azure_sql_properties_typeProperties_server": {
            "type": "string",
            "defaultValue": "atliq-sql-meet.database.windows.net"
        },
        "ls_azure_sql_properties_typeProperties_database": {
            "type": "string",
            "defaultValue": "atliq_commerce"
        },
        "ls_azure_sql_properties_typeProperties_userName": {
            "type": "string",
            "defaultValue": "atliq_admin"
        },
        "ls_adls_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://atliqlakemeet.dfs.core.windows.net/"
        }
    },
    "variables": {
        "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
    },
    "resources": [
        {
            "name": "[concat(parameters('factoryName'), '/ls_azure_sql')]",
            "type": "Microsoft.DataFactory/factories/linkedServices",
            "apiVersion": "2018-06-01",
            "properties": {
                "description": "Source OLTP database (atliq_commerce)",
                "annotations": [],
                "type": "AzureSqlDatabase",
                "typeProperties": {
                    "server": "[parameters('ls_azure_sql_properties_typeProperties_server')]",
                    "database": "[parameters('ls_azure_sql_properties_typeProperties_database')]",
                    "encrypt": "mandatory",
                    "trustServerCertificate": false,
                    "authenticationType": "SQL",
                    "userName": "[parameters('ls_azure_sql_properties_typeProperties_userName')]",
                    "password": {
                        "type": "SecureString",
                        "value": "[parameters('ls_azure_sql_password')]"
                    }
                }
            },
            "dependsOn": []
        },
        {
            "name": "[concat(parameters('factoryName'), '/ls_adls')]",
            "type": "Microsoft.DataFactory/factories/linkedServices",
            "apiVersion": "2018-06-01",
            "properties": {
                "description": "Data lake: landing + bronze",
                "annotations": [],
                "type": "AzureBlobFS",
                "typeProperties": {
                    "url": "[parameters('ls_adls_properties_typeProperties_url')]",
                    "accountKey": {
                        "type": "SecureString",
                        "value": "[parameters('ls_adls_accountKey')]"
                    }
                }
            },
            "dependsOn": []
        },
        {
            "name": "[concat(parameters('factoryName'), '/pl_nightly_ingest')]",
            "type": "Microsoft.DataFactory/factories/pipelines",
            "apiVersion": "2018-06-01",
            "properties": {
                "activities": [
                    {
                        "name": "Set run_start_at",
                        "type": "SetVariable",
                        "dependsOn": [],
                        "policy": {
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "variableName": "run_start_at",
                            "value": {
                                "value": "@if(empty(pipeline().parameters.run_start_at), formatDateTime(utcnow(), 'yyyy-MM-dd HH:mm:ss'), pipeline().parameters.run_start_at)",
                                "type": "Expression"
                            }
                        }
                    },
                    {
                        "name": "Lookup control table",
                        "type": "Lookup",
                        "dependsOn": [
                            {
                                "activity": "Set run_start_at",
                                "dependencyConditions": [
                                    "Succeeded"
                                ]
                            }
                        ],
                        "policy": {
                            "timeout": "0.12:00:00",
                            "retry": 3,
                            "retryIntervalInSeconds": 60,
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "source": {
                                "type": "AzureSqlSource",
                                "queryTimeout": "02:00:00",
                                "partitionOption": "None"
                            },
                            "dataset": {
                                "referenceName": "ds_sql_table",
                                "type": "DatasetReference",
                                "parameters": {
                                    "schema": "etl",
                                    "table_name": "control_table"
                                }
                            },
                            "firstRowOnly": false
                        }
                    },
                    {
                        "name": "ForEach table",
                        "type": "ForEach",
                        "dependsOn": [
                            {
                                "activity": "Lookup control table",
                                "dependencyConditions": [
                                    "Succeeded"
                                ]
                            }
                        ],
                        "userProperties": [],
                        "typeProperties": {
                            "items": {
                                "value": "@activity('Lookup control table').output.value",
                                "type": "Expression"
                            },
                            "isSequential": true,
                            "activities": [
                                {
                                    "name": "If incremental",
                                    "type": "IfCondition",
                                    "dependsOn": [],
                                    "userProperties": [],
                                    "typeProperties": {
                                        "expression": {
                                            "value": "@equals(item().load_type, 'incremental')",
                                            "type": "Expression"
                                        },
                                        "ifFalseActivities": [
                                            {
                                                "name": "Copy full",
                                                "type": "Copy",
                                                "dependsOn": [],
                                                "policy": {
                                                    "timeout": "0.12:00:00",
                                                    "retry": 3,
                                                    "retryIntervalInSeconds": 60,
                                                    "secureOutput": false,
                                                    "secureInput": false
                                                },
                                                "userProperties": [],
                                                "typeProperties": {
                                                    "source": {
                                                        "type": "AzureSqlSource",
                                                        "queryTimeout": "02:00:00",
                                                        "partitionOption": "None"
                                                    },
                                                    "sink": {
                                                        "type": "ParquetSink",
                                                        "storeSettings": {
                                                            "type": "AzureBlobFSWriteSettings"
                                                        },
                                                        "formatSettings": {
                                                            "type": "ParquetWriteSettings"
                                                        }
                                                    },
                                                    "enableStaging": false,
                                                    "translator": {
                                                        "type": "TabularTranslator",
                                                        "typeConversion": true,
                                                        "typeConversionSettings": {
                                                            "allowDataTruncation": true,
                                                            "treatBooleanAsNumber": false
                                                        }
                                                    }
                                                },
                                                "inputs": [
                                                    {
                                                        "referenceName": "ds_sql_table",
                                                        "type": "DatasetReference",
                                                        "parameters": {
                                                            "schema": "@item().source_schema",
                                                            "table_name": "@item().table_name"
                                                        }
                                                    }
                                                ],
                                                "outputs": [
                                                    {
                                                        "referenceName": "ds_bronze_parquet",
                                                        "type": "DatasetReference",
                                                        "parameters": {
                                                            "folder_path": {
                                                                "value": "bronze/@{item().table_name}",
                                                                "type": "Expression"
                                                            },
                                                            "file_name": "     @{item().table_name}.parquet"
                                                        }
                                                    }
                                                ]
                                            }
                                        ],
                                        "ifTrueActivities": [
                                            {
                                                "name": "Copy incremental",
                                                "type": "Copy",
                                                "dependsOn": [],
                                                "policy": {
                                                    "timeout": "0.12:00:00",
                                                    "retry": 3,
                                                    "retryIntervalInSeconds": 60,
                                                    "secureOutput": false,
                                                    "secureInput": false
                                                },
                                                "userProperties": [],
                                                "typeProperties": {
                                                    "source": {
                                                        "type": "AzureSqlSource",
                                                        "sqlReaderQuery": {
                                                            "value": "SELECT * FROM [@{item().source_schema}].[@{item().table_name}]\n   WHERE [@{item().watermark_column}] > '@{formatDateTime(item().last_loaded_at, 'yyyy-MM-dd HH:mm:ss')}'",
                                                            "type": "Expression"
                                                        },
                                                        "queryTimeout": "02:00:00",
                                                        "partitionOption": "None"
                                                    },
                                                    "sink": {
                                                        "type": "ParquetSink",
                                                        "storeSettings": {
                                                            "type": "AzureBlobFSWriteSettings"
                                                        },
                                                        "formatSettings": {
                                                            "type": "ParquetWriteSettings"
                                                        }
                                                    },
                                                    "enableStaging": false,
                                                    "translator": {
                                                        "type": "TabularTranslator",
                                                        "typeConversion": true,
                                                        "typeConversionSettings": {
                                                            "allowDataTruncation": true,
                                                            "treatBooleanAsNumber": false
                                                        }
                                                    }
                                                },
                                                "inputs": [
                                                    {
                                                        "referenceName": "ds_sql_table",
                                                        "type": "DatasetReference",
                                                        "parameters": {
                                                            "schema": {
                                                                "value": "@item().source_schema",
                                                                "type": "Expression"
                                                            },
                                                            "table_name": {
                                                                "value": "@item().table_name",
                                                                "type": "Expression"
                                                            }
                                                        }
                                                    }
                                                ],
                                                "outputs": [
                                                    {
                                                        "referenceName": "ds_bronze_parquet",
                                                        "type": "DatasetReference",
                                                        "parameters": {
                                                            "folder_path": {
                                                                "value": "bronze/@{item().table_name}/ingest_date=@{substring(variables('run_start_at'), 0, 10)}",
                                                                "type": "Expression"
                                                            },
                                                            "file_name": {
                                                                "value": "@{item().table_name}.parquet",
                                                                "type": "Expression"
                                                            }
                                                        }
                                                    }
                                                ]
                                            },
                                            {
                                                "name": "Update watermark",
                                                "type": "SqlServerStoredProcedure",
                                                "dependsOn": [
                                                    {
                                                        "activity": "Copy incremental",
                                                        "dependencyConditions": [
                                                            "Succeeded"
                                                        ]
                                                    }
                                                ],
                                                "policy": {
                                                    "timeout": "0.12:00:00",
                                                    "retry": 3,
                                                    "retryIntervalInSeconds": 60,
                                                    "secureOutput": false,
                                                    "secureInput": false
                                                },
                                                "userProperties": [],
                                                "typeProperties": {
                                                    "storedProcedureName": "[[etl].[usp_update_watermark]",
                                                    "storedProcedureParameters": {
                                                        "run_start_at": {
                                                            "value": {
                                                                "value": "@variables('run_start_at')",
                                                                "type": "Expression"
                                                            },
                                                            "type": "DateTime"
                                                        },
                                                        "table_name": {
                                                            "value": {
                                                                "value": "@item().table_name",
                                                                "type": "Expression"
                                                            },
                                                            "type": "String"
                                                        }
                                                    }
                                                },
                                                "linkedServiceName": {
                                                    "referenceName": "ls_azure_sql",
                                                    "type": "LinkedServiceReference"
                                                }
                                            }
                                        ]
                                    }
                                }
                            ]
                        }
                    },
                    {
                        "name": "Get CSV files",
                        "type": "GetMetadata",
                        "dependsOn": [
                            {
                                "activity": "Set run_start_at",
                                "dependencyConditions": [
                                    "Succeeded"
                                ]
                            }
                        ],
                        "policy": {
                            "timeout": "0.12:00:00",
                            "retry": 0,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "dataset": {
                                "referenceName": "ds_lake_binary",
                                "type": "DatasetReference",
                                "parameters": {
                                    "folder_path": "landing/csv"
                                }
                            },
                            "fieldList": [
                                "childItems"
                            ],
                            "storeSettings": {
                                "type": "AzureBlobFSReadSettings",
                                "recursive": true,
                                "enablePartitionDiscovery": false
                            },
                            "formatSettings": {
                                "type": "BinaryReadSettings"
                            }
                        }
                    },
                    {
                        "name": "Filter csv",
                        "type": "Filter",
                        "dependsOn": [
                            {
                                "activity": "Get CSV files",
                                "dependencyConditions": [
                                    "Succeeded"
                                ]
                            }
                        ],
                        "userProperties": [],
                        "typeProperties": {
                            "items": {
                                "value": "@activity('Get CSV files').output.childItems",
                                "type": "Expression"
                            },
                            "condition": {
                                "value": "@endswith(item().name, '.csv')",
                                "type": "Expression"
                            }
                        }
                    },
                    {
                        "name": "ForEach csv",
                        "type": "ForEach",
                        "dependsOn": [
                            {
                                "activity": "Filter csv",
                                "dependencyConditions": [
                                    "Succeeded"
                                ]
                            }
                        ],
                        "userProperties": [],
                        "typeProperties": {
                            "items": {
                                "value": "@activity('Filter csv').output.value",
                                "type": "Expression"
                            },
                            "activities": [
                                {
                                    "name": "Copy csv",
                                    "type": "Copy",
                                    "dependsOn": [],
                                    "policy": {
                                        "timeout": "0.12:00:00",
                                        "retry": 0,
                                        "retryIntervalInSeconds": 30,
                                        "secureOutput": false,
                                        "secureInput": false
                                    },
                                    "userProperties": [],
                                    "typeProperties": {
                                        "source": {
                                            "type": "BinarySource",
                                            "storeSettings": {
                                                "type": "AzureBlobFSReadSettings",
                                                "recursive": true,
                                                "wildcardFolderPath": "landing/csv",
                                                "wildcardFileName": {
                                                    "value": "@item().name",
                                                    "type": "Expression"
                                                },
                                                "deleteFilesAfterCompletion": false
                                            },
                                            "formatSettings": {
                                                "type": "BinaryReadSettings"
                                            }
                                        },
                                        "sink": {
                                            "type": "BinarySink",
                                            "storeSettings": {
                                                "type": "AzureBlobFSWriteSettings",
                                                "copyBehavior": "PreserveHierarchy"
                                            }
                                        },
                                        "enableStaging": false
                                    },
                                    "inputs": [
                                        {
                                            "referenceName": "ds_lake_binary",
                                            "type": "DatasetReference",
                                            "parameters": {
                                                "folder_path": "landing/csv"
                                            }
                                        }
                                    ],
                                    "outputs": [
                                        {
                                            "referenceName": "ds_lake_binary",
                                            "type": "DatasetReference",
                                            "parameters": {
                                                "folder_path": {
                                                    "value": "bronze/@{replace(item().name, '.csv', '')}",
                                                    "type": "Expression"
                                                }
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    },
                    {
                        "name": "Copy clickstream",
                        "type": "Copy",
                        "dependsOn": [
                            {
                                "activity": "Set run_start_at",
                                "dependencyConditions": [
                                    "Succeeded"
                                ]
                            }
                        ],
                        "policy": {
                            "timeout": "0.12:00:00",
                            "retry": 0,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "source": {
                                "type": "BinarySource",
                                "storeSettings": {
                                    "type": "AzureBlobFSReadSettings",
                                    "recursive": true,
                                    "wildcardFolderPath": "landing/clickstream",
                                    "wildcardFileName": "*.json",
                                    "deleteFilesAfterCompletion": false
                                },
                                "formatSettings": {
                                    "type": "BinaryReadSettings"
                                }
                            },
                            "sink": {
                                "type": "BinarySink",
                                "storeSettings": {
                                    "type": "AzureBlobFSWriteSettings",
                                    "copyBehavior": "PreserveHierarchy"
                                }
                            },
                            "enableStaging": false
                        },
                        "inputs": [
                            {
                                "referenceName": "ds_lake_binary",
                                "type": "DatasetReference",
                                "parameters": {
                                    "folder_path": "landing/clickstream"
                                }
                            }
                        ],
                        "outputs": [
                            {
                                "referenceName": "ds_lake_binary",
                                "type": "DatasetReference",
                                "parameters": {
                                    "folder_path": "bronze/clickstream"
                                }
                            }
                        ]
                    }
                ],
                "policy": {
                    "elapsedTimeMetric": {}
                },
                "parameters": {
                    "run_start_at": {
                        "type": "string"
                    }
                },
                "variables": {
                    "run_start_at": {
                        "type": "String"
                    }
                },
                "annotations": [],
                "lastPublishTime": "2026-10-23T17:08:53Z"
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/datasets/ds_sql_table')]",
                "[concat(variables('factoryId'), '/datasets/ds_lake_binary')]",
                "[concat(variables('factoryId'), '/datasets/ds_bronze_parquet')]",
                "[concat(variables('factoryId'), '/linkedServices/ls_azure_sql')]"
            ]
        },
        {
            "name": "[concat(parameters('factoryName'), '/ds_bronze_parquet')]",
            "type": "Microsoft.DataFactory/factories/datasets",
            "apiVersion": "2018-06-01",
            "properties": {
                "linkedServiceName": {
                    "referenceName": "ls_adls",
                    "type": "LinkedServiceReference"
                },
                "parameters": {
                    "folder_path": {
                        "type": "string"
                    },
                    "file_name": {
                        "type": "string"
                    }
                },
                "annotations": [],
                "type": "Parquet",
                "typeProperties": {
                    "location": {
                        "type": "AzureBlobFSLocation",
                        "fileName": {
                            "value": "@dataset().file_name",
                            "type": "Expression"
                        },
                        "folderPath": {
                            "value": "@dataset().folder_path",
                            "type": "Expression"
                        },
                        "fileSystem": "lakehouse"
                    },
                    "compressionCodec": "snappy"
                },
                "schema": []
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/linkedServices/ls_adls')]"
            ]
        },
        {
            "name": "[concat(parameters('factoryName'), '/ds_sql_table')]",
            "type": "Microsoft.DataFactory/factories/datasets",
            "apiVersion": "2018-06-01",
            "properties": {
                "linkedServiceName": {
                    "referenceName": "ls_azure_sql",
                    "type": "LinkedServiceReference"
                },
                "parameters": {
                    "schema": {
                        "type": "string"
                    },
                    "table_name": {
                        "type": "string"
                    }
                },
                "annotations": [],
                "type": "AzureSqlTable",
                "schema": [],
                "typeProperties": {
                    "schema": {
                        "value": "@dataset().schema",
                        "type": "Expression"
                    },
                    "table": {
                        "value": "@dataset().table_name",
                        "type": "Expression"
                    }
                }
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/linkedServices/ls_azure_sql')]"
            ]
        },
        {
            "name": "[concat(parameters('factoryName'), '/ds_lake_binary')]",
            "type": "Microsoft.DataFactory/factories/datasets",
            "apiVersion": "2018-06-01",
            "properties": {
                "linkedServiceName": {
                    "referenceName": "ls_adls",
                    "type": "LinkedServiceReference"
                },
                "parameters": {
                    "folder_path": {
                        "type": "string"
                    }
                },
                "annotations": [],
                "type": "Binary",
                "typeProperties": {
                    "location": {
                        "type": "AzureBlobFSLocation",
                        "folderPath": {
                            "value": "@dataset().folder_path",
                            "type": "Expression"
                        },
                        "fileSystem": "lakehouse"
                    }
                }
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/linkedServices/ls_adls')]"
            ]
        },
        {
            "name": "[concat(parameters('factoryName'), '/ls_databricks')]",
            "type": "Microsoft.DataFactory/factories/linkedServices",
            "apiVersion": "2018-06-01",
            "properties": {
                "annotations": [],
                "type": "AzureDatabricks",
                "typeProperties": {
                    "domain": "https://adb-7405612961370454.14.azuredatabricks.net",
                    "authentication": "MSI",
                    "workspaceResourceId": "/subscriptions/b552af2f-a022-4c50-bdf0-f6582f437d76/resourceGroups/rg-atliq-commerce/providers/Microsoft.Databricks/workspaces/atliq-dbx-meet",
                    "newClusterNodeType": "Standard_D4s_v5",
                    "newClusterNumOfWorker": "1",
                    "newClusterVersion": "16.4.x-scala2.12",
                    "clusterOption": "Fixed",
                    "newClusterInitScripts": []
                }
            },
            "dependsOn": []
        },
        {
            "name": "[concat(parameters('factoryName'), '/pl_nightly')]",
            "type": "Microsoft.DataFactory/factories/pipelines",
            "apiVersion": "2018-06-01",
            "properties": {
                "activities": [
                    {
                        "name": "run_start_at",
                        "type": "SetVariable",
                        "dependsOn": [],
                        "policy": {
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "variableName": "run_start_at",
                            "value": {
                                "value": "@formatDateTime(utcnow(), 'yyyy-MM-dd HH:mm:ss')",
                                "type": "Expression"
                            }
                        }
                    },
                    {
                        "name": "Run ingest",
                        "type": "ExecutePipeline",
                        "dependsOn": [
                            {
                                "activity": "run_start_at",
                                "dependencyConditions": [
                                    "Succeeded"
                                ]
                            }
                        ],
                        "policy": {
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "pipeline": {
                                "referenceName": "pl_nightly_ingest",
                                "type": "PipelineReference"
                            },
                            "waitOnCompletion": true,
                            "parameters": {
                                "run_start_at": {
                                    "value": "@variables('run_start_at')",
                                    "type": "Expression"
                                }
                            }
                        }
                    },
                    {
                        "name": "Run atliq_nightly",
                        "type": "DatabricksJob",
                        "dependsOn": [
                            {
                                "activity": "Run ingest",
                                "dependencyConditions": [
                                    "Succeeded"
                                ]
                            }
                        ],
                        "policy": {
                            "timeout": "0.12:00:00",
                            "retry": 0,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "jobId": "953702782755300",
                            "jobParameters": {
                                "run_date": {
                                    "value": "@substring(variables('run_start_at'), 0, 10)",
                                    "type": "Expression"
                                }
                            }
                        },
                        "linkedServiceName": {
                            "referenceName": "ls_databricks",
                            "type": "LinkedServiceReference"
                        }
                    }
                ],
                "policy": {
                    "elapsedTimeMetric": {}
                },
                "variables": {
                    "run_start_at": {
                        "type": "String"
                    }
                },
                "annotations": []
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/pipelines/pl_nightly_ingest')]",
                "[concat(variables('factoryId'), '/linkedServices/ls_databricks')]"
            ]
        },
        {
            "name": "[concat(parameters('factoryName'), '/tr_nightly_0100')]",
            "type": "Microsoft.DataFactory/factories/triggers",
            "apiVersion": "2018-06-01",
            "properties": {
                "annotations": [],
                "runtimeState": "Started",
                "pipelines": [
                    {
                        "pipelineReference": {
                            "referenceName": "pl_nightly",
                            "type": "PipelineReference"
                        },
                        "parameters": {}
                    }
                ],
                "type": "ScheduleTrigger",
                "typeProperties": {
                    "recurrence": {
                        "frequency": "Day",
                        "interval": 1,
                        "startTime": "2026-11-13T01:00:00",
                        "timeZone": "Arabian Standard Time",
                        "schedule": {
                            "minutes": [
                                0
                            ],
                            "hours": [
                                1
                            ]
                        }
                    }
                }
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/pipelines/pl_nightly')]"
            ]
        }
    ]
}